rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Carpeta de fotografías del sitio web
    match /site_photos/{sectionId}/{allPaths=**} {
      // Lectura pública para que las fotos carguen en la web sin requerir login a los visitantes
      allow read: if true;
      
      // Solo el administrador autenticado puede subir, reemplazar o borrar imágenes
      // Solo permite archivos de imagen (jpg, png, webp) de hasta 15MB
      allow write: if request.auth != null 
                   && (request.resource == null || (request.resource.contentType.matches('image/.*') 
                   && request.resource.size < 15 * 1024 * 1024));
    }

    // Denegar cualquier otro acceso por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
