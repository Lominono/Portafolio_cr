rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de fotografías del sitio web
    match /site_photos/{sectionId} {
      // Cualquier visitante puede ver las fotografías del portafolio
      allow read: if true;
      
      // Solo el administrador autorizado puede crear, modificar o eliminar fotos
      allow write: if request.auth != null && (
        request.auth.token.email == "Christianespinolas2317@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // Denegar cualquier otro acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
