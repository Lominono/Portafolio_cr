rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de fotografías del sitio web
    match /site_photos/{sectionId} {
      // Cualquier visitante puede ver las fotografías del portafolio
      allow read: if true;
      
      // Solo el administrador autenticado puede crear, modificar o eliminar fotos
      // Puedes restringir a un UID específico:
      // allow write: if request.auth != null && request.auth.uid == "TU_UID_ADMIN_AQUI";
      allow write: if request.auth != null;
    }

    // Denegar cualquier otro acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
