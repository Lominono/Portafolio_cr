rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Colección de fotografías del sitio web
    match /site_photos/{sectionId} {
      // Cualquier visitante puede ver las fotografías del portafolio
      allow read: if true;
      
      // Permitir gestionar fotos a cualquier usuario autenticado
      allow write: if request.auth != null;
    }

    // Colección de administradores verificados mediante clave de seguridad
    match /authorized_admins/{userId} {
      allow read, write: if request.auth != null;
    }

    // Configuración global del sitio web (ej. características activas de tarifas)
    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Denegar cualquier otro acceso por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
